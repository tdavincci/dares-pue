# Rendered at container start by the nginx image (envsubst). PORT, BACKEND_URL and NGINX_LOCAL_RESOLVERS come
# from the environment (defaults in the Dockerfile). Only defined variables are replaced, so nginx's own vars are safe.
server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  client_max_body_size 5m;

  # Resolve the backend per request, so the portal still starts when the backend host doesn't exist
  # (e.g. on Railway, where the portal calls the API by its public URL and this proxy isn't used).
  resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;

  # API, Swagger UIs and Odyssey Standard API are served by the NestJS backend.
  location /api/ {
    set $backend "${BACKEND_URL}";
    proxy_pass $backend;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Live updates (Server-Sent Events): don't buffer, keep the stream open.
    proxy_buffering off;
    proxy_read_timeout 1h;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }

  # Angular's JS/CSS/fonts have a content hash in their names, so they never change: cache for good.
  location ~* \.(js|css|woff2?)$ {
    expires 30d;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  # Icons and images keep the same name when replaced: cache briefly, then check for a new version.
  location ~* \.(png|svg|ico|webmanifest)$ {
    add_header Cache-Control "public, max-age=3600, must-revalidate";
    try_files $uri =404;
  }
}
