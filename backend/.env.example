NODE_ENV=production
PORT=3000
CORS_ORIGINS=http://localhost:4200

# PostgreSQL
# Option A: Supabase (or any hosted Postgres). Paste the "Session pooler" connection string from
# Supabase → Project → Connect. When DATABASE_URL is set, DB_HOST/PORT/USER/PASSWORD/NAME are ignored
# and SSL is on by default.
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_POOL_MAX=10

# Option B: your own PostgreSQL (used when DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=dares_pue
# DB_SSL=false             # default: true with DATABASE_URL, false otherwise
DB_SYNC=false              # never true in production; schema comes from migrations
DB_RUN_MIGRATIONS=true     # apply pending migrations on boot

# Admin portal auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h
ADMIN_EMAIL=admin@dares-pue.local     # seeded only when the users table is empty
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=System Administrator

# Odyssey Standard API
ODYSSEY_ACCESS_TOKEN_TTL_SECONDS=86400   # lifetime of tokens issued by /token-renewal
ODYSSEY_DEFAULT_PAGE_LIMIT=0             # 0 = return everything in the window when pageLimit is omitted
ODYSSEY_MAX_PAGE_LIMIT=5000
ODYSSEY_MAX_RANGE_HOURS=744
ODYSSEY_READING_INTERVAL_MINUTES=15      # down-sample positions to 1 per pump per N minutes (0 = raw)
ODYSSEY_PAYMENT_TRANSACTION_TYPE=FULL_PAYMENT   # one of FULL_PAYMENT, INSTALLMENT_PAYMENT, NON_CONTRACT_PAYMENT, DISCOUNT, REVERSAL, ENERGY_CREDIT
ODYSSEY_REVERSAL_NEGATIVE_AMOUNT=true            # REVERSAL events send the reversed amount as a negative number

# Tracking
ONLINE_THRESHOLD_MINUTES=30
DEFAULT_GEOFENCE_RADIUS_METERS=500
STATIONARY_SPEED_KPH=5                 # GPS speeds below this are stored as 0 (indoor/stationary drift); 0 = raw
GT06_ENABLED=true
GT06_PORT=5023
GT06_TIME_OFFSET_MINUTES=0
GT06_IDLE_TIMEOUT_SECONDS=900
OSMAND_REQUIRE_KEY=true

# Payments
PAYMENTS_ALLOW_INSTALLMENTS=false
DEFAULT_CURRENCY=NGN
